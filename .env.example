# Copy to .env.local for local development. NEVER commit real values.
# Production values are set as Railway service variables (sealed where possible).

NODE_ENV=production
# Railway-provided application URL, set after deploy
APP_URL=https://YOUR-DOMAIN.example
BETTER_AUTH_URL=https://YOUR-DOMAIN.example
BETTER_AUTH_SECRET=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET
# Railway: ${{Postgres.DATABASE_URL}} (private network). Local default: pglite:./.data/pglite
DATABASE_URL=POSTGRES_CONNECTION_STRING_FROM_RAILWAY

STORAGE_DRIVER=r2
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET=dear-swritsinh-media
R2_ACCESS_KEY_ID=BUCKET_SCOPED_KEY
R2_SECRET_ACCESS_KEY=BUCKET_SCOPED_SECRET
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
MEDIA_SIGNED_URL_TTL_SECONDS=180

CHILD_DEFAULT_NAME=Swritsinh Chauhan
CHILD_DEFAULT_PREFERRED_NAME=Swritsinh
CHILD_DEFAULT_BIRTH_DATE=2021-11-13
CHILD_BIRTH_DATE_REQUIRES_CONFIRMATION=true
APP_TIMEZONE=Asia/Kolkata

PUBLIC_SIGNUP_ENABLED=false
JOB_CONCURRENCY=1
MAX_UPLOAD_MB=2048
MAX_ZIP_ENTRIES=20000
MAX_ZIP_TOTAL_MB=20480
ENABLE_AI_CAPTIONS=false
ENABLE_VIDEO_RENDER=true
# Pinned OpenMontage checkout used only by the studio worker. Absent on the website service.
OPENMONTAGE_ROOT=
# Studio worker: chrome-headless-shell is installed in Dockerfile.openmontage at build time.
# Do not set REMOTION_BROWSER_EXECUTABLE unless you are debugging a custom browser path.
STUDIO_ASSET_CAP=5000
# Paid providers stay off until a cap above 0 is set and the owner approves that job.
STUDIO_SPEND_CAP_USD=0
# Optional. Presence is shown in AI Studio; the value is never sent to the browser.
PIXABAY_API_KEY=

# Web service: false on Railway (the separate worker service processes jobs).
RUN_WORKER_IN_WEB=false
# Railway sits behind a proxy; client IPs come from X-Forwarded-For (used for login rate limits).
TRUST_PROXY=true
